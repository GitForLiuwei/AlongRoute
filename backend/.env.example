# 不要将实际 Key 提交到公开仓库；请复制为 backend/.env 并自行填写。
AMAP_WEB_SERVICE_KEY=
# JS API 2.0 安全密钥，只存储于后端。
AMAP_JS_SECURITY_CODE=
# 无 Web 服务 Key 时自动启用模拟模式。
# 开发环境允许的前端来源（使用 Vite 代理时通常不需 CORS）。
# 默认使用枢纽优先选点；legacy 可用于旧出口分流策略的对照/回退。
CANDIDATE_STRATEGY=hub_first
# 可选：本机/私网 OSRM，留空时几何粗排，高德精算约束不变。
OSRM_BASE_URL=
# 部署路网日期和 profile 版本，仅用于诊断，不是高德路况时间。
OSRM_DATA_VERSION=
